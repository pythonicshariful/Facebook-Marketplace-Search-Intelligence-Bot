# ---------------------------------------------------------------------------
# Marketplace Vehicle Search Intelligence Bot - environment configuration
# Copy to .env (scripts\setup_venv.ps1 does this and generates the keys).
# NEVER commit .env.
# ---------------------------------------------------------------------------

# Flask session signing key (long random string). Generated by setup script.
SECRET_KEY=

# Fernet key used to encrypt secrets (e.g. Telegram token) stored in the DB.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# If you lose/change this key, re-enter the Telegram token in the dashboard.
FMBOT_FERNET_KEY=

# Web server binding. Keep 127.0.0.1 unless behind a reverse proxy + firewall.
FMBOT_HOST=127.0.0.1
FMBOT_PORT=8080

# Optional overrides
# DATABASE_URL=sqlite:///G:/path/to/app.db
# FMBOT_DATA_DIR=G:/path/to/data
# FMBOT_LOG_DIR=G:/path/to/logs
FMBOT_LOG_LEVEL=INFO

# Chrome / ChromeDriver. Leave empty to let Selenium Manager resolve a driver
# matching the installed Chrome automatically.
CHROME_BINARY=
CHROMEDRIVER_PATH=

# Scheduler
FMBOT_SCHEDULER_ENABLED=true
FMBOT_SCHEDULER_TICK_SECONDS=15

# Telegram bootstrap values (optional). Imported into the encrypted settings
# store on first start if no token is configured in the dashboard yet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to true only if served over HTTPS (reverse proxy) - marks cookies Secure.
FMBOT_SECURE_COOKIES=false
